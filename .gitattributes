* text=auto

# Unity YAML - keep as text, use UnityYAMLMerge for conflicts
*.unity          text merge=unityyamlmerge eol=lf
*.prefab         text merge=unityyamlmerge eol=lf
*.asset          text merge=unityyamlmerge eol=lf
*.mat            text merge=unityyamlmerge eol=lf
*.controller     text merge=unityyamlmerge eol=lf
*.anim           text merge=unityyamlmerge eol=lf
*.meta           text eol=lf
*.cs             text diff=csharp eol=lf
*.shader         text eol=lf
*.json           text eol=lf

# Binary assets - never diff or normalize
*.fbx            binary
*.blend          binary
*.obj            binary
*.png            binary
*.jpg            binary
*.tga            binary
*.psd            binary
*.wav            binary
*.mp3            binary
*.ogg            binary
*.ttf            binary
*.unityweb       binary
*.wasm           binary
